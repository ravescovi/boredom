{
  "name": "@bordon-ai/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "if [ \"$VERCEL_ENV\" = \"production\" ] && [ -n \"$DATABASE_URL_UNPOOLED\" ]; then echo 'Applying pending Prisma migrations...' && prisma migrate deploy --config=../../packages/database/prisma.config.ts; else echo 'Skipping migrate deploy (non-prod or DATABASE_URL_UNPOOLED unset)'; fi && prisma generate --config=../../packages/database/prisma.config.ts && next build",
    "dev": "next dev",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "prisma generate --config=../../packages/database/prisma.config.ts && tsc --noEmit"
  },
  "dependencies": {
    "@bordon-ai/ai": "workspace:*",
    "@bordon-ai/database": "workspace:*",
    "@bordon-ai/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.13.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17"
  }
}
