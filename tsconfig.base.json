{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@bordom-ai/ai": ["packages/ai/src/index.ts"],
      "@bordom-ai/database": ["packages/database/src/index.ts"],
      "@bordom-ai/shared": ["packages/shared/src/index.ts"]
    }
  }
}
